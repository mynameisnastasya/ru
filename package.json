{
  "name": "wink-gifting",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--import=./scripts/runtime-shim.mjs node scripts/dev.mjs",
    "build": "NODE_OPTIONS=--import=./scripts/runtime-shim.mjs next build --webpack",
    "start": "NODE_OPTIONS=--import=./scripts/runtime-shim.mjs next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--import=./scripts/runtime-shim.mjs vitest run --pool=threads --maxWorkers=1 --no-file-parallelism"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/instrument-serif": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@neondatabase/neon-js": "0.7.0-beta",
    "motion": "^12.23.24",
    "next": "16.3.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
