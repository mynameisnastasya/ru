    {
      "parameters": {
        "jsCode": "const metrics = Array.isArray($json.data) ? $json.data : [];\nconst recentPosts = $('Threads · Recent Posts').first().json.data || [];\n\nfunction value(name) {\n  const m = metrics.find(x => x.name === name);\n  if (!m) return 0;\n  if (m.total_value && m.total_value.value != null) return Number(m.total_value.value) || 0;\n  const values = Array.isArray(m.values) ? m.values : [];\n  if (!values.length) return 0;\n  return Number(values[values.length - 1].value) || 0;\n}\n\nconst likes = value('likes');\nconst replies = value('replies');\nconst reposts = value('reposts');\nconst quotes = value('quotes');\n\nreturn [{\n  json: {\n    ok: true,\n    message: 'Аналитика обновлена',\n    metrics: {\n      published: recentPosts.length,\n      replies,\n      resolved: '—',\n      engagement: likes + replies + reposts + quotes\n    },\n    details: {\n      views: value('views'),\n      likes,\n      replies,\n      reposts,\n      quotes,\n      followers: value('followers_count'),\n      recentPostsFetched: recentPosts.length\n    }\n  }\n}];"
