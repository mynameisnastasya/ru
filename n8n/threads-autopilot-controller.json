        "jsCode": "const topic = ($json.payload?.topic || '').trim() || 'Дай одну сильную идею для Threads по теме моего бизнеса.';\nconst instructions = `Ты автор Threads. Пиши по-русски, коротко, разговорно и конкретно.\nНе используй канцелярит, фразы \"в современном мире\" и \"давайте разберемся\", чрезмерные эмодзи, выдуманные цифры и фальшивые истории.\nСтруктура: сильная первая строка, одна мысль, конкретный пример или наблюдение, естественный финал для обсуждения.\nВерни только текст публикации без кавычек и пояснений.`;\n\nreturn [{\n  json: {\n    requestBody: {\n      model: 'gpt-5.6-luna',\n      instructions,\n      input: `Тема или задача: ${topic}`\n    }\n  }\n}];"
