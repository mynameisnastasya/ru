    {
      "parameters": {
        "jsCode": "const parts = Array.isArray($json.output) ? $json.output : [];\nlet text = '';\nfor (const out of parts) {\n  for (const c of (out.content || [])) {\n    if ((c.type === 'output_text' || typeof c.text === 'string') && c.text) {\n      text += (text ? '\\n' : '') + c.text;\n    }\n  }\n}\ntext = text.trim();\nif (!text) throw new Error('OpenAI returned no text');\nreturn [{ json: { ok: true, message: 'Черновик готов', draft: text } }];"
