    {
      "parameters": {
        "jsCode": "const all = [];\nconst seen = new Set();\nfor (const item of $input.all()) {\n  const rows = Array.isArray(item.json.data) ? item.json.data : [];\n  for (const r of rows) {\n    if (!r?.id || r.is_reply_owned_by_me === true || seen.has(r.id)) continue;\n    seen.add(r.id);\n    all.push({\n      reply_id: r.id,\n      username: r.username || '',\n      text: r.text || '',\n      timestamp: r.timestamp || '',\n      permalink: r.permalink || '',\n      root_post_id: r.root_post?.id || '',\n      replied_to_id: r.replied_to?.id || ''\n    });\n  }\n}\nall.sort((a,b) => String(a.timestamp).localeCompare(String(b.timestamp)));\nreturn [{\n  json: {\n    noReplies: all.length === 0,\n    replies: all.slice(-30)\n  }\n}];"
