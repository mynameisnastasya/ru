        "jsCode": "let text = '';\nfor (const out of ($json.output || [])) {\n  for (const c of (out.content || [])) {\n    if (c.text) text += c.text;\n  }\n}\ntext = text.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/,'');\nlet decisions;\ntry {\n  decisions = JSON.parse(text);\n} catch {\n  throw new Error('OpenAI reply decision was not valid JSON');\n}\nif (!Array.isArray(decisions)) throw new Error('Reply decisions must be an array');\n\nconst input = $('Normalize Input').first().json;\nconst replies = $('Collect Incoming Replies').first().json.replies || [];\nconst allowedIds = new Set(replies.map(r => String(r.reply_id)));\ndecisions = decisions\n  .filter(d => d && allowedIds.has(String(d.reply_id)))\n  .map(d => ({\n    reply_id: String(d.reply_id),\n    action: ['reply','skip','human'].includes(d.action) ? d.action : 'human',\n    text: String(d.text || '').trim()\n  }));\n\nreturn [{\n  json: {\n    decisions,\n    replies,\n    autoReplies: input.options?.autoReplies === true,\n    dryRun: input.options?.dryRun === true\n  }\n}];"
      },
