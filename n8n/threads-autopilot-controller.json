        "jsCode": "const posts = ($json.data || []).filter(p => p.has_replies).slice(0, 10);\nif (!posts.length) return [{ json: { noTargets: true, thread_id: '' } }];\nreturn posts.map(p => ({\n  json: {\n    noTargets: false,\n    thread_id: p.id,\n    post_text: p.text || '',\n    post_permalink: p.permalink || ''\n  }\n}));"
